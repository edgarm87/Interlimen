@page "/pricing"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Pricing — INTERLIMEN</PageTitle>

<HeadContent>
    <meta name="description" content="INTERLIMEN pricing — Individual plan at $55/mo, Team plan at $199/mo. 14-day free trial, no credit card required. Full access to 30M+ immigration records." />
    <meta property="og:title" content="Pricing — INTERLIMEN" />
    <meta property="og:description" content="Start free for 14 days. Individual at $55/mo or $45/mo annually. Team at $199/mo or $159/mo annually." />
    <meta property="og:url" content="https://interlimen.com/pricing" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INTERLIMEN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Pricing — INTERLIMEN" />
    <meta name="twitter:description" content="Start free for 14 days. Individual at $55/mo or $45/mo annually. Team at $199/mo or $159/mo annually." />
    <link rel="canonical" href="https://interlimen.com/pricing" />
</HeadContent>

<div class="pricing-page">

    <!-- Nav -->
    <nav class="nav">
        <div class="nav-inner">
            <a href="/" class="logo">INTERLIMEN</a>
            <a href="/account/login" class="nav-login">Sign In →</a>
        </div>
    </nav>

    <!-- Header -->
    <section class="pricing-header">
        <div class="eyebrow">SIMPLE PRICING</div>
        <h1 class="pricing-title">Start free. Pay when you're ready.</h1>
        <p class="pricing-sub">14-day free trial on all plans. No credit card required.</p>

        <!-- Toggle -->
        <div class="billing-toggle">
            <span class="@(_annual ? "toggle-label" : "toggle-label active")">Monthly</span>
            <div class="toggle-track" @onclick="ToggleBilling">
                <div class="toggle-thumb @(_annual ? "annual" : "")"></div>
            </div>
            <span class="@(_annual ? "toggle-label active" : "toggle-label")">
                Annually
                <span class="save-badge">Save 18%</span>
            </span>
        </div>
    </section>

    <!-- Pricing Cards -->
    <section class="pricing-cards">
        <div class="cards-inner">

            <!-- Individual -->
            <div class="card">
                <div class="card-header">
                    <div class="plan-name">Individual</div>
                    <div class="plan-desc">For solo practitioners</div>
                </div>
                <div class="card-price">
                    <span class="price-amount">@(_annual ? "$45" : "$55")</span>
                    <span class="price-period">/user/month</span>
                </div>
                @if (_annual)
                {
                    <div class="price-note">billed $540/year</div>
                }
                else
                {
                    <div class="price-note">billed monthly</div>
                }
                <a href="/account/register" class="btn-primary">Start Free Trial</a>
                <div class="features-list">
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        1 user
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Full access to all 30M+ records
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Judge analytics & grant rates
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Detention & detainer tracking
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Court backlog & case search
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Quarterly data updates
                    </div>
                </div>
            </div>

            <!-- Team -->
            <div class="card card-featured">
                <div class="featured-badge">MOST POPULAR</div>
                <div class="card-header">
                    <div class="plan-name">Team</div>
                    <div class="plan-desc">For small firms</div>
                </div>
                <div class="card-price">
                    <span class="price-amount">@(_annual ? "$159" : "$199")</span>
                    <span class="price-period">/month</span>
                </div>
                @if (_annual)
                {
                    <div class="price-note">billed $1,908/year</div>
                }
                else
                {
                    <div class="price-note">billed monthly</div>
                }
                <a href="/account/register" class="btn-primary btn-white">Start Free Trial</a>
                <div class="features-list">
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Up to 5 users
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Everything in Individual
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Shared team access
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Priority support
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Paralegal & associate seats
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Quarterly data updates
                    </div>
                </div>
            </div>
            
            <!-- Enterprise -->
            <div class="card card-enterprise">
                <div class="card-header">
                    <div class="plan-name">Enterprise</div>
                    <div class="plan-desc">For large firms</div>
                </div>
                <div class="card-price">
                    <span class="price-amount" style="font-size:36px; padding-top:8px;">Custom</span>
                </div>
                <div class="price-note">tailored to your firm's needs</div>
                <a href="mailto:hello@interlimen.com" class="btn-primary btn-enterprise">Contact Us</a>
                <div class="features-list">
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Unlimited users
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Everything in Team
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Dedicated support
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Custom onboarding
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        SLA guarantee
                    </div>
                    <div class="feature-item">
                        <span class="material-icons check">check_circle</span>
                        Custom data exports
                    </div>
                </div>
            </div>

        </div>

        <!-- FAQ -->
        <div class="faq">
            <div class="faq-item">
                <div class="faq-q">What's included in the free trial?</div>
                <div class="faq-a">Full access to everything — all 30M+ records, all pages, no restrictions. 14 days, no credit card required.</div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Where does the data come from?</div>
                <div class="faq-a">All data is sourced directly from ICE and EOIR via Freedom of Information Act releases. We process and index the raw government files.</div>
            </div>
            <div class="faq-item">
                <div class="faq-q">How often is data updated?</div>
                <div class="faq-a">We update data quarterly as new FOIA releases become available. Current data covers through early March 2026.</div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Can I cancel anytime?</div>
                <div class="faq-a">Yes. Cancel anytime from your account settings. Annual plans are non-refundable after 30 days.</div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <span class="logo">INTERLIMEN</span>
            <span class="footer-copy">Data sourced from public FOIA releases. Not affiliated with ICE or EOIR.</span>
            <div style="display:flex; gap:16px; align-items:center;">
                <a href="/terms" class="footer-link">Terms</a>
                <a href="/privacy" class="footer-link">Privacy</a>
                <a href="/account/login" class="footer-link">Sign In</a>
            </div>
        </div>
    </footer>

</div>

@code {
    private bool _annual = true;
    private void ToggleBilling() => _annual = !_annual;
}

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .pricing-page {
        background: #f4f6f9;
        min-height: 100vh;
        font-family: 'DM Sans', 'Helvetica Neue', sans-serif;
        color: #1a2332;
    }

    .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        background: rgba(244,246,249,0.92);
        border-bottom: 1px solid rgba(27,79,114,0.10);
        backdrop-filter: blur(12px);
    }
    .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 18px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .logo {
        font-family: 'DM Mono', monospace;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.2em;
        color: #1B4F72;
        text-decoration: none;
    }
    .nav-login {
        color: #2E86C1;
        text-decoration: none;
        font-size: 14px;
    }
    .nav-login:hover { color: #1B4F72; }

    .pricing-header {
        padding: 140px 32px 60px;
        text-align: center;
    }
    .eyebrow {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.15em;
        color: #2E86C1;
        margin-bottom: 20px;
    }
    .pricing-title {
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1B4F72;
        margin-bottom: 16px;
    }
    .pricing-sub {
        font-size: 18px;
        color: #5a6a7e;
        margin-bottom: 40px;
    }

    /* Toggle */
    .billing-toggle {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid rgba(27,79,114,0.15);
        border-radius: 50px;
        padding: 8px 20px;
    }
    .toggle-label {
        font-size: 14px;
        color: #8a9ab0;
        cursor: pointer;
    }
    .toggle-label.active { color: #1B4F72; font-weight: 600; }
    .toggle-track {
        width: 44px;
        height: 24px;
        background: #1B4F72;
        border-radius: 12px;
        position: relative;
        cursor: pointer;
        transition: background 0.2s;
    }
    .toggle-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: #fff;
        border-radius: 50%;
        transition: transform 0.2s;
    }
    .toggle-thumb.annual { transform: translateX(20px); }
    .save-badge {
        background: #e8f4e8;
        color: #2d7a2d;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 20px;
        margin-left: 6px;
        letter-spacing: 0.02em;
    }

    /* Cards */
    .pricing-cards { padding: 0 32px 80px; }
    .cards-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
        margin-bottom: 64px;
    }

    .card {
        background: #fff;
        border: 1px solid rgba(27,79,114,0.12);
        border-radius: 12px;
        padding: 36px;
        position: relative;
    }
    .card-featured {
        background: #1B4F72;
        border-color: #1B4F72;
    }
    .featured-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: #2E86C1;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        padding: 4px 14px;
        border-radius: 20px;
    }
    .plan-name {
        font-size: 20px;
        font-weight: 700;
        color: #1B4F72;
        margin-bottom: 4px;
    }
    .card-featured .plan-name { color: #fff; }
    .plan-desc {
        font-size: 14px;
        color: #5a6a7e;
        margin-bottom: 24px;
    }
    .card-featured .plan-desc { color: rgba(255,255,255,0.65); }
    .card-price {
        display: flex;
        align-items: baseline;
        gap: 4px;
        margin-bottom: 4px;
        min-height: 70px;
    }
    .price-amount {
        font-size: 52px;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #1B4F72;
    }
    .card-featured .price-amount { color: #fff; }
    .price-period {
        font-size: 15px;
        color: #5a6a7e;
    }
    .card-featured .price-period { color: rgba(255,255,255,0.65); }
    .price-note {
        font-size: 13px;
        color: #8a9ab0;
        margin-bottom: 28px;
        min-height: 20px;
    }
    .card-featured .price-note { color: rgba(255,255,255,0.5); }

    .btn-primary {
        display: block;
        text-align: center;
        background: #1B4F72;
        color: #fff;
        text-decoration: none;
        padding: 14px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 28px;
        transition: background 0.2s;
    }
    .btn-primary:hover { background: #2E86C1; }
    .btn-white {
        background: #fff;
        color: #1B4F72;
    }
    .btn-white:hover { background: #f0f4f8; }

    .features-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .feature-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #1a2332;
    }
    .card-featured .feature-item { color: rgba(255,255,255,0.85); }
    .check {
        font-size: 18px !important;
        color: #2E86C1;
    }
    .card-featured .check { color: #7ab8e0; }

    .card-enterprise {
        border: 2px dashed rgba(27,79,114,0.20);
        background: rgba(27,79,114,0.02);
    }
    .btn-enterprise {
        background: transparent;
        color: #1B4F72;
        border: 2px solid #1B4F72;
    }
    .btn-enterprise:hover {
        background: #1B4F72;
        color: #fff;
    }

    /* FAQ */
    .faq {
        max-width: 800px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .faq-item {
        background: #fff;
        border: 1px solid rgba(27,79,114,0.10);
        border-radius: 10px;
        padding: 24px;
    }
    .faq-q {
        font-size: 15px;
        font-weight: 600;
        color: #1B4F72;
        margin-bottom: 8px;
    }
    .faq-a {
        font-size: 14px;
        line-height: 1.6;
        color: #5a6a7e;
    }

    /* Footer */
    .footer {
        border-top: 1px solid rgba(27,79,114,0.10);
        padding: 28px 0;
        background: #f4f6f9;
    }
    .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }
    .footer-copy {
        font-size: 12px;
        color: #8a9ab0;
        flex: 1;
        text-align: center;
    }
    .footer-link {
        font-size: 13px;
        color: #2E86C1;
        text-decoration: none;
    }

    @@media (max-width: 900px) {
        .cards-inner { grid-template-columns: 1fr; }
        .faq { grid-template-columns: 1fr; }
    }
</style>