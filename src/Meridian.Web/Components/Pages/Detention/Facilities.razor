@page "/detention/facilities"
@using Microsoft.AspNetCore.Authorization
@using Meridian.Application.Features.Detention
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Detention Facilities — INTERLIMEN</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Detention Facilities</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Active ICE detention facilities — Sep 2023 to Mar 2026 · Source: Deportation Data Project
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total Facilities</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_facilities.Count</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Across 55 states/territories</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Currently Detained</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @_totalCurrentDetained.ToString("N0")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Latest snapshot</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Largest Facility</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@_largestFacility</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">By current population</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Data Through</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @(_latestSnapshotDate?.ToString("MMM yyyy") ?? "—")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Deportation Data Project</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Search facility</MudText>
                <input type="text" placeholder="e.g. Stewart, Adelanto"
                       style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                       @oninput="OnSearchChanged" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">State</MudText>
                <input type="text" placeholder="e.g. TX, CA, FL" maxlength="2"
                       style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                       @oninput="OnStateChanged" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Showing @_filtered.Count facilities
    </MudText>

    <MudTable Items="_filtered" Dense="false" Hover="true" Striped="true"
              RowsPerPage="25" Elevation="2">
        <HeaderContent>
            <MudTh>Facility</MudTh>
            <MudTh>State</MudTh>
            <MudTh>Code</MudTh>
            <MudTh Style="text-align:right">Current Detained</MudTh>
            <MudTh>Source</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink Href="@($"/detention/trends/{context.FacilityId}")"
                         Typo="Typo.body2">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd>@context.State</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="Color.Default">
                    @context.FacilityType
                </MudChip>
            </MudTd>
            <MudTd Style="text-align:right">
                <strong>@context.CurrentDetained.ToString("N0")</strong>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Color="Color.Secondary">DDP</MudText>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
        </PagerContent>
    </MudTable>
}

@code {
    private bool _loading = true;
    private List<FacilityPopulationDto> _facilities = new();
    private List<FacilityPopulationDto> _filtered = new();
    private DateTime? _latestSnapshotDate;
    private int _totalCurrentDetained = 0;
    private string _largestFacility = "";
    private string _searchName = "";
    private string _searchState = "";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _facilities = await Mediator.Send(new GetActiveFacilitiesWithPopulation());
        _totalCurrentDetained = _facilities.Sum(f => f.CurrentDetained);
        _largestFacility = _facilities
            .OrderByDescending(f => f.CurrentDetained)
            .FirstOrDefault()?.Name ?? "—";
        _latestSnapshotDate = _facilities
            .Where(f => f.CurrentDetained > 0)
            .Max(f => (DateTime?)f.SnapshotDate);
        FilterData();
        _loading = false;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchName = e.Value?.ToString() ?? "";
        FilterData();
        StateHasChanged();
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        _searchState = e.Value?.ToString() ?? "";
        FilterData();
        StateHasChanged();
    }

    private void FilterData()
    {
        var q = _facilities.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_searchName))
            q = q.Where(f => f.Name.Contains(_searchName, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_searchState))
            q = q.Where(f => f.State.Equals(_searchState, StringComparison.OrdinalIgnoreCase));

        _filtered = q.OrderByDescending(f => f.CurrentDetained).ToList();
    }
}