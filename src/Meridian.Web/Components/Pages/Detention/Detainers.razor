@page "/detention/detainers"
@using Microsoft.AspNetCore.Authorization
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Detainers — INTERLIMEN</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">ICE Detainers</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    ICE requests to local jails to hold individuals · Sep 2023–Oct 2025 · Source: ICE ERO via FOIA
</MudText>

@if (_loadingSummary)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Total Detainers"
                     Value="@(_summary?.TotalDetainers.ToString("N0") ?? "—")"
                     Subtitle="Sep 2023–Oct 2025"
                     Tooltip="Total ICE detainer requests lodged with local jails between September 2023 and October 2025, sourced from ICE ERO FOIA data." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Active Detainers"
                     Value="@(_summary?.ActiveDetainers.ToString("N0") ?? "—")"
                     Subtitle="No departed date · last 6 months"
                     ValueStyle="color:#F57C00"
                     Tooltip="Detainers issued in the last 6 months with no recorded departure date — the individual may still be held pending ICE pickup." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Resulted in Removal"
                     Value="@(_summary?.ResultedInRemoval.ToString("N0") ?? "—")"
                     Subtitle="Departed date recorded"
                     ValueStyle="color:#D32F2F"
                     Tooltip="Detainers where a departure date was recorded, indicating the individual was transferred to ICE and likely removed." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Top State"
                     Value="@(_summary?.TopState ?? "—")"
                     Subtitle="Highest detainer volume"
                     Tooltip="The state where local jails received the most ICE detainer requests in this dataset." />
        </MudItem>
    </MudGrid>
}

<!-- Filters -->
<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_filterState"
                              Label="State"
                              Placeholder="e.g. TEXAS"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Dense="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_filterCountry"
                              Label="Citizenship Country"
                              Placeholder="e.g. MEXICO"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Dense="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_filterCriminality"
                           Label="Criminality"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true">
                    <MudSelectItem Value="@("1 Convicted Criminal")">Convicted Criminal</MudSelectItem>
                    <MudSelectItem Value="@("2 Pending Criminal Charges")">Pending Criminal Charges</MudSelectItem>
                    <MudSelectItem Value="@("3 No Known Criminality")">No Known Criminality</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSwitch @bind-Value="_filterActiveOnly"
                           Label="Active Only"
                           Color="Color.Primary"
                           Class="mt-2" />
            </MudItem>
            <MudItem xs="12" sm="6" md="1">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ApplyFilters"
                           Class="mt-1"
                           FullWidth="true">
                    Search
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Results Table -->
<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Detainer Records</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @if (_pagedResult != null)
                {
                    @($"{_pagedResult.TotalCount:N0} records · Page {_currentPage} of {TotalPages}")
                }
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_loadingData)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }
        else if (_pagedResult?.Items.Any() == true)
        {
            <MudTable Items="_pagedResult.Items" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh aria-sort='@GetAriaSort("PrepareDate")'>
                        <MudButton OnClick='@(() => SortBy("PrepareDate"))' EndIcon='@GetSortIcon("PrepareDate")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Prepare Date</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("State")'>
                        <MudButton OnClick='@(() => SortBy("State"))' EndIcon='@GetSortIcon("State")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">State</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Facility")'>
                        <MudButton OnClick='@(() => SortBy("Facility"))' EndIcon='@GetSortIcon("Facility")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Facility</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Nationality")'>
                        <MudButton OnClick='@(() => SortBy("Nationality"))' EndIcon='@GetSortIcon("Nationality")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Nationality</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Criminality")'>
                        <MudButton OnClick='@(() => SortBy("Criminality"))' EndIcon='@GetSortIcon("Criminality")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Criminality</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Status")'>
                        <MudButton OnClick='@(() => SortBy("Status"))' EndIcon='@GetSortIcon("Status")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Status</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Departed")'>
                        <MudButton OnClick='@(() => SortBy("Departed"))' EndIcon='@GetSortIcon("Departed")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Departed</MudButton>
                    </MudTh>
                    <MudTh aria-sort='@GetAriaSort("Destination")'>
                        <MudButton OnClick='@(() => SortBy("Destination"))' EndIcon='@GetSortIcon("Destination")'
                                   Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Destination</MudButton>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PrepareDate.ToString("MM/dd/yyyy")</MudTd>
                    <MudTd>@(context.FacilityState ?? "—")</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@(context.FacilityName ?? "—")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.FacilityAor ?? "")</MudText>
                    </MudTd>
                    <MudTd>@(context.CitizenshipCountry ?? "—")</MudTd>
                    <MudTd>
                        @if (context.Criminality != null)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@GetCriminalityColor(context.Criminality)">
                                @GetCriminalityLabel(context.Criminality)
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Warning : Color.Success)">
                            @(context.IsActive ? "Active" : "Resolved")
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.DepartedDate?.ToString("MM/dd/yyyy") ?? "—")</MudTd>
                    <MudTd>@(context.DepartureCountry ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>

            <!-- Pagination -->
            <div class="d-flex justify-center mt-4">
                <MudPagination Count="TotalPages"
                               Selected="_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                No detainers found matching your filters.
            </MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    private bool _loadingSummary = true;
    private bool _loadingData = true;
    private DetainerSummaryDto? _summary;
    private PagedDetainersDto? _pagedResult;
    private int _currentPage = 1;
    private const int PageSize = 50;
    private string _sortBy = "PrepareDate";
    private bool _sortDescending = true;

    private string? _filterState;
    private string? _filterCountry;
    private string? _filterCriminality;
    private bool _filterActiveOnly;

    private int TotalPages => _pagedResult == null ? 1
        : (int)Math.Ceiling((double)_pagedResult.TotalCount / PageSize);

    protected override async Task OnInitializedAsync()
    {
        _summary = await Mediator.Send(new GetDetainerSummary());
        _loadingSummary = false;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loadingData = true;
        _pagedResult = await Mediator.Send(new GetDetainers(
            Page: _currentPage,
            PageSize: PageSize,
            State: string.IsNullOrWhiteSpace(_filterState) ? null : _filterState.Trim().ToUpper(),
            CitizenshipCountry: string.IsNullOrWhiteSpace(_filterCountry) ? null : _filterCountry.Trim().ToUpper(),
            Criminality: _filterCriminality,
            ActiveOnly: _filterActiveOnly ? true : null,
            SortBy: _sortBy,
            SortDescending: _sortDescending
        ));
        _loadingData = false;
    }

    private string GetAriaSort(string column) => _sortBy != column ? "none"
        : _sortDescending ? "descending" : "ascending";

    private string GetSortIcon(string column) => _sortBy != column ? Icons.Material.Filled.UnfoldMore
        : _sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;

    private async Task SortBy(string column)
    {
        if (_loadingData) return;
        _sortDescending = _sortBy == column ? !_sortDescending : false;
        _sortBy = column;
        _currentPage = 1;
        await LoadData();
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadData();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private Color GetCriminalityColor(string criminality)
    {
        if (criminality.StartsWith("1 ")) return Color.Error;
        if (criminality.StartsWith("2 ")) return Color.Warning;
        if (criminality.StartsWith("3 ")) return Color.Default;
        return Color.Default;
    }

    private string GetCriminalityLabel(string criminality)
    {
        if (criminality.StartsWith("1 ")) return "Convicted";
        if (criminality.StartsWith("2 ")) return "Pending";
        if (criminality.StartsWith("3 ")) return criminality[2..].Trim();
        return criminality;
    }
}