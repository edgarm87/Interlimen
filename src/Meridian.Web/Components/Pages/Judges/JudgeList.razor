@page "/judges"
@using Microsoft.AspNetCore.Authorization
@using Meridian.Application.Features.Judges
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Nav

<PageTitle>Judge Analytics — INTERLIMEN</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Judge Analytics</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Grant and denial rates by immigration judge · Source: EOIR FOIA data · 12.9M proceedings
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading judge statistics...</MudText>
}
else
{
    <!-- Summary KPIs -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Total Judges"
                     Value="@_judges.Count.ToString("N0")"
                     Subtitle="With decided cases"
                     Tooltip="Number of immigration judges in the EOIR database who have at least one case with a recorded outcome." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Avg Grant Rate"
                     Value="@($"{(_judges.Any(j => j.TotalCasesDecided > 0) ? _judges.Where(j => j.TotalCasesDecided > 0).Average(j => j.GrantRatePercent).ToString("F1") : "—")}%")"
                     Subtitle="Across all judges"
                     ValueStyle="color:#2E7D32"
                     Tooltip="Simple average grant rate across all judges with at least one decided case. Not weighted by case volume." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Avg Removal Rate"
                     Value="@($"{(_judges.Any(j => j.TotalCasesDecided > 0) ? _judges.Where(j => j.TotalCasesDecided > 0).Average(j => j.RemovalOrderRatePercent).ToString("F1") : "—")}%")"
                     Subtitle="Across all judges"
                     ValueStyle="color:#D32F2F"
                     Tooltip="Simple average removal order rate across all judges with at least one decided case. Not weighted by case volume." />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Total Cases"
                     Value="@(_judges.Sum(j => j.TotalCasesDecided).ToString("N0"))"
                     Subtitle="Decided proceedings"
                     Tooltip="Sum of all decided cases across every judge in the dataset, sourced from EOIR FOIA records." />
        </MudItem>
    </MudGrid>

    <!-- Filters -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Judge Name</MudText>
                    <input type="text"
                           placeholder="Search by last name..."
                           style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                           @oninput="@(e => { _filterName = e.Value?.ToString() ?? ""; FilterChanged(); })" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Court City</MudText>
                    <input type="text"
                           placeholder="e.g. NEW YORK"
                           style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                           @oninput="@(e => { _filterCity = e.Value?.ToString() ?? ""; FilterChanged(); })" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sort By</MudText>
                    <select style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px"
                            @onchange="@(e => { _sortBy = e.Value?.ToString() ?? "cases"; FilterChanged(); })">
                        <option value="cases" selected="@(_sortBy == "cases")">Total Cases</option>
                        <option value="grant" selected="@(_sortBy == "grant")">Grant Rate</option>
                        <option value="removal" selected="@(_sortBy == "removal")">Removal Rate</option>
                        <option value="name" selected="@(_sortBy == "name")">Name</option>
                    </select>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Judge Table -->
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Immigration Judges</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_filtered.Count.ToString("N0") judges · click a row to see case details
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTable Items="_filtered.Take(200)"
                      Dense="true" Hover="true" Striped="true"
                      OnRowClick="@((TableRowClickEventArgs<JudgeSummaryDto> args) => NavToJudge(args.Item))">
                <HeaderContent>
                    <MudTh>Judge</MudTh>
                    <MudTh>Court</MudTh>
                    <MudTh Style="text-align:right">Cases Decided</MudTh>
                    <MudTh Style="text-align:right">Grant Rate</MudTh>
                    <MudTh Style="text-align:right">Removal Rate</MudTh>
                    <MudTh Style="text-align:right">Denial Rate</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="font-weight-medium">
                            @context.FullName
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.CourtCity</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CourtState</MudText>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        @context.TotalCasesDecided.ToString("N0")
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetGrantColor(context.GrantRatePercent)">
                            @context.GrantRatePercent.ToString("F1")%
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetRemovalColor(context.RemovalOrderRatePercent)">
                            @context.RemovalOrderRatePercent.ToString("F1")%
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        @context.DenialRatePercent.ToString("F1")%
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_filtered.Count > 200)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">
                    Showing top 200 of @_filtered.Count.ToString("N0") results. Use filters to narrow down.
                </MudText>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    private bool _loading = true;
    private List<JudgeSummaryDto> _judges = new();
    private List<JudgeSummaryDto> _filtered = new();
    private string _filterName = "";
    private string _filterCity = "";
    private string _sortBy = "cases";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _judges = await Mediator.Send(new GetAllJudgesWithStats());
        ApplyFilters();
        _loading = false;
    }

    private void FilterChanged() => ApplyFilters();

    private void ApplyFilters()
    {
        var q = _judges.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_filterName))
            q = q.Where(j => j.FullName.Contains(_filterName, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_filterCity))
            q = q.Where(j => j.CourtCity.Contains(_filterCity, StringComparison.OrdinalIgnoreCase));

        q = _sortBy switch
        {
            "grant" => q.OrderByDescending(j => j.GrantRatePercent),
            "removal" => q.OrderByDescending(j => j.RemovalOrderRatePercent),
            "name" => q.OrderBy(j => j.FullName),
            _ => q.OrderByDescending(j => j.TotalCasesDecided)
        };

        _filtered = q.ToList();
    }

    private Color GetGrantColor(decimal rate) => rate switch
    {
        >= 30 => Color.Success,
        >= 15 => Color.Warning,
        _ => Color.Error
    };

    private Color GetRemovalColor(decimal rate) => rate switch
    {
        >= 80 => Color.Error,
        >= 60 => Color.Warning,
        _ => Color.Default
    };
    
    private void NavToJudge(JudgeSummaryDto judge)
    {
        Nav.NavigateTo($"/judges/{judge.Id}");
    }
}