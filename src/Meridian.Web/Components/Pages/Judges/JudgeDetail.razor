@page "/judges/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Meridian.Application.Features.Judges
@using Meridian.Application.Features.Courts
@using Meridian.Domain.Entities
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Nav

<PageTitle>Judge Detail — INTERLIMEN</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_judge == null)
{
    <MudAlert Severity="Severity.Error">Judge not found.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Text" Color="Color.Primary"
               OnClick="@(() => Nav.NavigateTo("/judges"))"
               Class="mb-4">
        ← Back to Judges
    </MudButton>

    <MudText Typo="Typo.h4" Class="mb-1">@_judge.FullName</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @_judge.CourtCity, @_judge.CourtState · Immigration Court
    </MudText>

    <!-- Stats KPIs -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Cases Decided</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @_judge.TotalCasesDecided.ToString("N0")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total proceedings</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Grant Rate</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold"
                             Style="@($"color:{GetRateColor(_judge.GrantRatePercent, true)}")">
                        @_judge.GrantRatePercent.ToString("F1")%
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Relief granted</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Removal Rate</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold"
                             Style="@($"color:{GetRateColor(_judge.RemovalOrderRatePercent, false)}")">
                        @_judge.RemovalOrderRatePercent.ToString("F1")%
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Orders of removal</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Denial Rate</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @_judge.DenialRatePercent.ToString("F1")%
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Relief denied</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Recent Cases -->
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Recent Cases</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_cases.Count.ToString("N0") proceedings shown · Source: EOIR FOIA data
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
    <MudCardContent>
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:#f5f5f5; border-radius:8px">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">From Year</MudText>
            <input type="number"
                   placeholder="e.g. 2020"
                   min="2000" max="2026"
                   style="width:100%; padding:10px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                   @oninput="@(e => _fromYear = int.TryParse(e.Value?.ToString(), out var y) ? y : (int?)null)" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">To Year</MudText>
            <input type="number"
                   placeholder="e.g. 2026"
                   min="2000" max="2026"
                   style="width:100%; padding:10px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                   @oninput="@(e => _toYear = int.TryParse(e.Value?.ToString(), out var y) ? y : (int?)null)" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Sort By</MudText>
            <select style="width:100%; padding:10px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px"
                    @onchange="@(e => { _sortBy = e.Value?.ToString() ?? "date_desc"; ApplyFilters(); })">
                <option value="date_desc">Most Recent First</option>
                <option value="date_asc">Oldest First</option>
                <option value="outcome">By Outcome</option>
                <option value="nationality">By Nationality</option>
            </select>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ApplyFilters"
                       FullWidth="true"
                       Class="mt-4">
                Filter
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>
            @if (_loadingCases)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_cases.Any())
            {
                <MudTable Items="_cases" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Case #</MudTh>
                        <MudTh>Nationality</MudTh>
                        <MudTh>Case Type</MudTh>
                        <MudTh>Outcome</MudTh>
                        <MudTh>Decision Date</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="font-family:monospace">
                                @context.CaseNumber
                            </MudText>
                        </MudTd>
                        <MudTd>@(context.RespondentNationality ?? "—")</MudTd>
                        <MudTd>@context.CaseType</MudTd>
                        <MudTd>
                            @if (context.Outcome.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@GetOutcomeColor(context.Outcome.Value)">
                                    @GetOutcomeLabel(context.Outcome.Value)
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Pending</MudText>
                            }
                        </MudTd>
                        <MudTd>@(context.DecisionDate?.ToString("MM/dd/yyyy") ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No cases found.</MudText>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _loadingCases = false;
    private JudgeSummaryDto? _judge;
    private List<CourtCase> _cases = new();
    private int? _fromYear;
    private int? _toYear;
    private string _sortBy = "date_desc";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _judge = await Mediator.Send(new GetJudgeById(Id));
        _loading = false;
        await LoadCases();
    }

    private async Task LoadCases()
    {
        _loadingCases = true;
        StateHasChanged();
        if (_judge != null)
        {
            var result = await Mediator.Send(new GetCasesByJudge(Id, _fromYear, _toYear, _sortBy));
            _cases = result.ToList();
        }
        _loadingCases = false;
    }

    private async Task ApplyFilters() => await LoadCases();

    private string GetRateColor(decimal rate, bool isGrant) =>
        isGrant ? (rate >= 30 ? "#2E7D32" : rate >= 15 ? "#F57C00" : "#D32F2F")
            : (rate >= 80 ? "#D32F2F" : rate >= 60 ? "#F57C00" : "#2E7D32");

    private Color GetOutcomeColor(CaseOutcome outcome) => outcome switch
    {
        CaseOutcome.GrantedRelief => Color.Success,
        CaseOutcome.OrderOfRemoval => Color.Error,
        CaseOutcome.VoluntaryDeparture => Color.Warning,
        _ => Color.Default
    };

    private string GetOutcomeLabel(CaseOutcome outcome) => outcome switch
    {
        CaseOutcome.GrantedRelief => "Granted",
        CaseOutcome.OrderOfRemoval => "Removal",
        CaseOutcome.VoluntaryDeparture => "Vol. Departure",
        CaseOutcome.Terminated => "Terminated",
        CaseOutcome.Withdrawn => "Withdrawn",
        _ => "Other"
    };
}