@page "/account/login"
@using Meridian.Web.Components.Layout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AuthLayout

<PageTitle>Sign In — Meridian</PageTitle>

<MudCard Elevation="4" Class="login-card">
    <MudCardContent>
        <div class="d-flex justify-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Gavel"
                     Color="Color.Primary"
                     Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">
            Meridian
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center"
                 Color="Color.Secondary" Class="mb-6">
            Legal Intelligence for Immigration Professionals
        </MudText>

        @if (_error == "invalid")
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Invalid email or password.
            </MudAlert>
        }
        @if (_error == "locked")
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Account is temporarily locked. Please try again later.
            </MudAlert>
        }

        <form method="post" action="/auth/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <AntiforgeryToken />
    
            <div class="mb-3">
                <label style="font-size:12px; color:#666; display:block; margin-bottom:4px">Email</label>
                <input type="email"
                       name="email"
                       required
                       style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:16px; box-sizing:border-box"
                       placeholder="you@yourfirm.com" />
            </div>

            <div class="mb-4">
                <label style="font-size:12px; color:#666; display:block; margin-bottom:4px">Password</label>
                <input type="password"
                       name="password"
                       required
                       style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:16px; box-sizing:border-box"
                       placeholder="••••••••" />
            </div>

            <div class="d-flex justify-end mb-4">
                <MudLink Href="/account/forgot-password" Typo="Typo.body2">
                    Forgot password?
                </MudLink>
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mb-3">
                Sign In
            </MudButton>
        </form>

        <MudText Align="Align.Center" Typo="Typo.body2">
            Don't have an account?
            <MudLink Href="/account/register">Start free trial</MudLink>
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? _error { get; set; }
}