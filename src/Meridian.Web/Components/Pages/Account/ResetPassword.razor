@page "/account/reset-password"
@using Meridian.Web.Components.Layout
@using Microsoft.AspNetCore.Identity
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AuthLayout
@inject UserManager<Meridian.Infrastructure.Identity.AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Reset Password — INTERLIMEN</PageTitle>

<MudCard Elevation="4" Class="login-card">
    <MudCardContent>
        <div class="d-flex justify-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.LockReset"
                     Color="Color.Primary"
                     Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">
            Choose a new password
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        @if (_success)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Password reset successfully. You can now sign in.
            </MudAlert>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Href="/account/login">
                Sign In
            </MudButton>
        }
        else
        {
            <MudTextField @bind-Value="_password"
                          Label="New Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Disabled="_loading" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Disabled="_loading" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleReset"
                       Disabled="_loading"
                       Class="mb-3">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Class="mr-2" />
                }
                Reset Password
            </MudButton>
        }
    </MudCardContent>
</MudCard>

@code {
    private string _password = "";
    private string _confirmPassword = "";
    private string _errorMessage = "";
    private bool _loading = false;
    private bool _success = false;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private async Task HandleReset()
    {
        _errorMessage = "";

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Please enter a new password.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = "Invalid reset link. Please request a new one.";
            return;
        }

        _loading = true;
        var user = await UserManager.FindByEmailAsync(Email);

        if (user == null)
        {
            _success = true; // Don't reveal user doesn't exist
            _loading = false;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Token, _password);
        _loading = false;

        if (result.Succeeded)
        {
            _success = true;
        }
        else
        {
            _errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }
}