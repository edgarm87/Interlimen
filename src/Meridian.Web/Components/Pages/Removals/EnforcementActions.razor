@page "/removals/enforcement"
@using Microsoft.AspNetCore.Authorization
@using Meridian.Application.Features.Enforcement
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Enforcement Actions — INTERLIMEN</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Enforcement Actions</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    ICE arrests (Sep 2023–Oct 2025) and removals (FY2012–FY2023) · Source: ICE ERO via FOIA
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Loading records — this may take a moment...
    </MudText>
}
else
{
    <!-- KPI Row -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="3">
            <KpiCard Title="Total Removals"
                     Value="@(_summary?.TotalRemovals.ToString("N0") ?? "—")"
                     Subtitle="FY2012 — FY2023"
                     Tooltip="Total confirmed removals (deportations) from FY2012 through FY2023, sourced from ICE ERO FOIA records." />
        </MudItem>
        <MudItem xs="12" md="3">
            <KpiCard Title="Criminal Arrests"
                     Value="@(_summary?.CriminalArrests.ToString("N0") ?? "—")"
                     Subtitle="Based on arrest records · Sep 2023–Oct 2025"
                     ValueStyle="color:#D32F2F"
                     Tooltip="ICE arrests where the individual had a prior criminal conviction or pending criminal charge, per ICE ERO records from September 2023 through October 2025." />
        </MudItem>
        <MudItem xs="12" md="3">
            <KpiCard Title="Top Nationality"
                     Value="@(_summary?.TopNationality ?? "—")"
                     Subtitle="Highest volume country"
                     Tooltip="The nationality (country of birth) with the most enforcement actions recorded across arrests and removals." />
        </MudItem>
        <MudItem xs="12" md="3">
            <KpiCard Title="Top Field Office"
                     Value="@(_summary?.TopAOR ?? "—")"
                     Subtitle="Highest arrest volume AOR"
                     Tooltip="The ICE Area of Responsibility (AOR) field office that recorded the highest number of arrests in this dataset." />
        </MudItem>
    </MudGrid>

    <MudGrid>
        <!-- Arrests by Field Office -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Arrests by Field Office (AOR)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Sep 2023 — Oct 2025 · Source: DDP FOIA
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_byArrestAOR.Take(10)" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Field Office</MudTh>
                            <MudTh Style="text-align:right">Arrests</MudTh>
                            <MudTh Style="text-align:right">Criminal %</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.FieldOffice</MudTd>
                            <MudTd Style="text-align:right">
                                @context.TotalArrests.ToString("N0")
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.CriminalPercent > 50 ? Color.Error : Color.Default)">
                                    @context.CriminalPercent.ToString("F1")%
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Removals by Port of Departure -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Removals by Port of Departure</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            FY2012 — FY2023 · Top 10 departure points
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_byAOR.Take(10)" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Port of Departure</MudTh>
                            <MudTh Style="text-align:right">Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.AreaOfResponsibility</MudTd>
                            <MudTd Style="text-align:right">
                                @context.TotalRemovals.ToString("N0")
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Removals by Disposition -->
        <MudItem xs="12" md="6" Class="mt-4">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Removals by Case Category</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Case category breakdown · FY2012–FY2023
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_byDisposition" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Case Category</MudTh>
                            <MudTh Style="text-align:right">Count</MudTh>
                            <MudTh Style="text-align:right">%</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2">@context.DispositionCode</MudText>
                            </MudTd>
                            <MudTd Style="text-align:right">@context.Count.ToString("N0")</MudTd>
                            <MudTd Style="text-align:right">@context.Percent.ToString("F1")%</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Top Nationalities -->
        <MudItem xs="12" md="6" Class="mt-4">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Top 15 Nationalities</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            By removal volume · FY2012 to FY2023
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @foreach (var item in _byNationality)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.body2">@item.Nationality</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @item.Count.ToString("N0") (@item.Percent.ToString("F1")%)
                                </MudText>
                            </div>
                            <MudProgressLinear Value="@((double)item.Percent)"
                                               Color="Color.Primary"
                                               Size="Size.Small" />
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private EnforcementSummaryDto? _summary;
    private List<RemovalsByAORDto> _byAOR = new();
    private List<ArrestsByFieldOfficeDto> _byArrestAOR = new();
    private List<RemovalsByDispositionDto> _byDisposition = new();
    private List<RemovalsByNationalityICEDto> _byNationality = new();

    protected override async Task OnInitializedAsync()
    {
        //_loading = true;
        //await Task.WhenAll(
        //    LoadSummary(),
        //    LoadAOR(),
        //    LoadArrestAOR(),
        //    LoadDisposition(),
        //    LoadNationalities()
        //);
        //_loading = false;
        
        _loading = true;
        _summary = await Mediator.Send(new GetEnforcementSummary());
        _byAOR = await Mediator.Send(new GetRemovalsByAOR());
        _byArrestAOR = await Mediator.Send(new GetArrestsByFieldOffice());
        _byDisposition = await Mediator.Send(new GetRemovalsByDisposition());
        _byNationality = await Mediator.Send(new GetTopNationalitiesICE(15));
        _loading = false;
    }

