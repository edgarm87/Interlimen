@page "/removals/nationality"
@using Microsoft.AspNetCore.Authorization
@using Meridian.Application.Features.Removals
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Removals by Nationality — INTERLIMEN</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Removals by Nationality</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Noncitizen removals by criminal status and country · FY2013–FY2022 · Source: OHSS (no longer updated)
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Fiscal Year</MudText>
            <select style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px"
                    @onchange="OnYearChanged">
                @foreach (var year in _years)
                {
                    <option value="@year" selected="@(year == _selectedYear)">FY@(year)</option>
                }
            </select>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Search country</MudText>
            <input type="text"
                   placeholder="e.g. Mexico"
                   style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px; box-sizing:border-box"
                   @oninput="OnSearchChanged" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Sort by</MudText>
            <select style="width:100%; padding:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-top:4px"
                    @onchange="OnSortChanged">
                <option value="total_desc" selected="@(_sortBy == "total_desc")">Highest Total</option>
                <option value="total_asc" selected="@(_sortBy == "total_asc")">Lowest Total</option>
                <option value="criminal_desc" selected="@(_sortBy == "criminal_desc")">Highest Criminal</option>
                <option value="criminal_asc" selected="@(_sortBy == "criminal_asc")">Lowest Criminal</option>
                <option value="noncriminal_desc" selected="@(_sortBy == "noncriminal_desc")">Highest Non-Criminal</option>
                <option value="noncriminal_asc" selected="@(_sortBy == "noncriminal_asc")">Lowest Non-Criminal</option>
                <option value="percentage_desc" selected="@(_sortBy == "percentage_desc")">Highest Criminal %</option>
                <option value="percentage_asc" selected="@(_sortBy == "percentage_asc")">Lowest Criminal %</option>
                <option value="name_asc" selected="@(_sortBy == "name_asc")">Country A-Z</option>
                <option value="name_desc" selected="@(_sortBy == "name_desc")">Country Z-A</option>
            </select>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Showing @_filtered.Count countries ·
        @_filtered.Sum(x => x.TotalRemovals).ToString("N0") total removals
    </MudText>

    <MudTable @ref="_table" Items="_filtered" Dense="false" Hover="true" Striped="true"
              RowsPerPage="25" Elevation="2">
        <HeaderContent>
            <MudTh aria-sort='@GetAriaSort("name")'>
                <MudButton OnClick='@(() => SortByColumn("name"))' EndIcon='@GetSortIcon("name")'
                           Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Country</MudButton>
            </MudTh>
            <MudTh Style="text-align:right" aria-sort='@GetAriaSort("total")'>
                <MudButton OnClick='@(() => SortByColumn("total"))' EndIcon='@GetSortIcon("total")'
                           Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Total Removals</MudButton>
            </MudTh>
            <MudTh Style="text-align:right" aria-sort='@GetAriaSort("criminal")'>
                <MudButton OnClick='@(() => SortByColumn("criminal"))' EndIcon='@GetSortIcon("criminal")'
                           Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Criminal</MudButton>
            </MudTh>
            <MudTh Style="text-align:right" aria-sort='@GetAriaSort("noncriminal")'>
                <MudButton OnClick='@(() => SortByColumn("noncriminal"))' EndIcon='@GetSortIcon("noncriminal")'
                           Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Non-Criminal</MudButton>
            </MudTh>
            <MudTh Style="text-align:right" aria-sort='@GetAriaSort("percentage")'>
                <MudButton OnClick='@(() => SortByColumn("percentage"))' EndIcon='@GetSortIcon("percentage")'
                           Style="text-transform:none; white-space:nowrap;" Size="Size.Small">Criminal %</MudButton>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.NationalityDisplay</MudTd>
            <MudTd Style="text-align:right">
                <strong>@context.TotalRemovals.ToString("N0")</strong>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Color="Color.Error">
                    @context.CriminalRemovals.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right">
                @context.NonCriminalRemovals.ToString("N0")
            </MudTd>
            <MudTd Style="text-align:right">
                @{
                    var pct = CriminalPercentage(context);
                }
                <MudChip T="string" Size="Size.Small"
                         Color="@(pct > 50 ? Color.Error : Color.Default)">
                    @pct.ToString("F1")%
                </MudChip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{25, 50, 100}" />
        </PagerContent>
    </MudTable>
}

@code {
    private bool _loading = true;
    private int _selectedYear = 2022;
    private string _searchCountry = "";
    private string _sortBy = "total_desc";
    private MudTable<RemovalByNationalityDto>? _table;

    private List<int> _years = Enumerable.Range(2013, 10).Reverse().ToList();
    private List<RemovalByNationalityDto> _allData = new();
    private List<RemovalByNationalityDto> _filtered = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            _selectedYear = year;
            await LoadData();
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchCountry = e.Value?.ToString() ?? "";
        FilterData();
        StateHasChanged();
    }
    
    private void OnSortChanged(ChangeEventArgs e)
    {
        _sortBy = e.Value?.ToString() ?? "total_desc";
        FilterData();
        StateHasChanged();
    }

    private string GetAriaSort(string column) => _sortBy == $"{column}_asc" ? "ascending"
        : _sortBy == $"{column}_desc" ? "descending" : "none";

    private string GetSortIcon(string column) => GetAriaSort(column) switch
    {
        "ascending" => Icons.Material.Filled.ArrowUpward,
        "descending" => Icons.Material.Filled.ArrowDownward,
        _ => Icons.Material.Filled.UnfoldMore
    };

    private void SortByColumn(string column)
    {
        var descending = _sortBy == $"{column}_asc"
            || (_sortBy != $"{column}_desc" && column != "name");
        _sortBy = $"{column}_{(descending ? "desc" : "asc")}";
        FilterData();
    }

    private static decimal CriminalPercentage(RemovalByNationalityDto row) => row.TotalRemovals > 0
        ? (decimal)row.CriminalRemovals / row.TotalRemovals * 100 : 0;

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();
        _allData = await Mediator.Send(new GetAllRemovalsByYear(_selectedYear));
        FilterData();
        _loading = false;
        StateHasChanged();
    }

    private void FilterData()
    {
        IEnumerable<RemovalByNationalityDto> q = _allData;

        if (!string.IsNullOrWhiteSpace(_searchCountry))
            q = q.Where(x => x.NationalityDisplay
                .Contains(_searchCountry, StringComparison.OrdinalIgnoreCase));

        var ordered = _sortBy switch
        {
            "total_asc" => q.OrderBy(x => x.TotalRemovals),
            "criminal_desc" => q.OrderByDescending(x => x.CriminalRemovals),
            "criminal_asc" => q.OrderBy(x => x.CriminalRemovals),
            "noncriminal_desc" => q.OrderByDescending(x => x.NonCriminalRemovals),
            "noncriminal_asc" => q.OrderBy(x => x.NonCriminalRemovals),
            "percentage_desc" => q.OrderByDescending(CriminalPercentage),
            "percentage_asc" => q.OrderBy(CriminalPercentage),
            "name_asc" => q.OrderBy(x => x.NationalityDisplay),
            "name_desc" => q.OrderByDescending(x => x.NationalityDisplay),
            _ => q.OrderByDescending(x => x.TotalRemovals)
        };
        _filtered = ordered.ThenBy(x => x.NationalityDisplay).ToList();
        _table?.NavigateTo(0);
    }
}
