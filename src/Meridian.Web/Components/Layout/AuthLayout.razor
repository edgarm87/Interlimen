@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider Theme="_theme" />

<div style="min-height:100vh; background:#f4f6f9; display:flex; flex-direction:column;">
    <!-- Nav -->
    <nav style="background:rgba(244,246,249,0.92); border-bottom:1px solid rgba(27,79,114,0.10); backdrop-filter:blur(12px); padding:16px 32px; display:flex; justify-content:space-between; align-items:center;">
        <a href="/" style="font-family:'DM Mono',monospace; font-size:14px; font-weight:500; letter-spacing:0.2em; color:#1B4F72; text-decoration:none;">MERIDIAN</a>
        <a href="/" style="font-size:14px; color:#2E86C1; text-decoration:none;">← Back to home</a>
    </nav>

    <!-- Content -->
    <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:40px 16px;">
        @Body
    </div>

    <!-- Footer -->
    <div style="padding:20px 32px; text-align:center; border-top:1px solid rgba(27,79,114,0.08);">
        <span style="font-size:12px; color:#8a9ab0;">Data sourced from public FOIA releases. Not affiliated with ICE or EOIR.</span>
    </div>
</div>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
    .login-card {
        width: 100%;
        max-width: 440px;
        background: #fff !important;
        border: 1px solid rgba(27,79,114,0.12) !important;
        border-radius: 10px !important;
        box-shadow: 0 4px 24px rgba(27,79,114,0.08) !important;
    }
    .mud-card-content { padding: 32px !important; }
    .mud-input-outlined .mud-input-outlined-border { border-color: rgba(27,79,114,0.25) !important; }
    .mud-input-outlined:hover .mud-input-outlined-border { border-color: #2E86C1 !important; }
    .mud-input-outlined.mud-focused .mud-input-outlined-border { border-color: #1B4F72 !important; }
    label.mud-input-label { color: #5a6a7e !important; }
    label.mud-input-label.mud-focused { color: #1B4F72 !important; }
</style>

@code {
    private MudTheme _theme = new MudTheme
    {
        Palette = new PaletteLight
        {
            Primary = "#1B4F72",
            Secondary = "#2E86C1",
            AppbarBackground = "#1B4F72",
        }
    };
}